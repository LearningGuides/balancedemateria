---
interface MdxModule {
  frontmatter: {
    title?: string;
    [key: string]: unknown;
  };
}

const modules = import.meta.glob<MdxModule>('../lessons/*.mdx', {
  eager: true,
});

const posts = Object.entries(modules).map(([path, module]) => {
  const slug = path
    .split('/')
    .pop()!
    .replace('.mdx', '');

  return {
    slug,
    ...module.frontmatter,
  };
});

import "../styles/global.css";

---
<meta charset="UTF-8">
<h1>Posts</h1>

<ul>
  {posts.map((post) => (
    <li>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/lessons/${post.slug}`}>
  {post.title ?? post.slug}
</a>
    </li>
  ))}
</ul>